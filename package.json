{
  "name": "pxtone-garage",
  "private": true,
  "version": "1.0.1",
  "main": "electron/main.mjs",
  "desktopName": "pxtone-garage.desktop",
  "type": "module",
  "scripts": {
    "worklet": "node scripts/build-worklet.mjs",
    "dev": "node scripts/build-worklet.mjs && vite",
    "build": "node scripts/build-worklet.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron": "pnpm build && electron .",
    "dist:electron": "pnpm build && electron-builder",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@lucide/vue": "^1.31.0",
    "pxtone-ts": "github:pithos-day/pxtone-ts#v1.0.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.8",
    "workbox-window": "^7.4.1"
  },
  "description": "A Web DAW compatible with Piston Collage",
  "author": "pithos",
  "license": "MIT",
  "homepage": "https://github.com/pithos-day/pxtone-garage",
  "build": {
    "appId": "day.pithos.pxtone-garage",
    "productName": "pxtone Garage",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "pithos-day",
        "repo": "pxtone-garage",
        "releaseType": "draft",
        "publishAutoUpdate": false
      }
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo"
    }
  }
}
