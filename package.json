{
  "name": "pxtone-garage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "worklet": "node scripts/build-worklet.mjs",
    "dev": "node scripts/build-worklet.mjs && vite",
    "build": "node scripts/build-worklet.mjs && vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "esbuild tests/multiproject.ts --bundle --platform=node --format=cjs --outfile=tests/.multiproject.cjs --log-level=error && node tests/.multiproject.cjs && esbuild tests/preview-sim.ts --bundle --platform=node --format=cjs --outfile=tests/.preview-sim.cjs --log-level=error && node tests/.preview-sim.cjs"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@lucide/vue": "^1.31.0",
    "pxtone-ts": "https://github.com/pithos-day/pxtone-ts.git",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.25.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
